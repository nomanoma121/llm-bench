# Downloaded model data; the catalog remains tracked.
/models/*/

# Local run state and build artifacts.
/runs/
/builds/
/renders/
/.state/
/bin/

# Adoption staging (docs/architecture.md §4.12): the lock file is created once
# and never deleted, and the staging/backup directories only exist during a run.
.adopt.lock
.adopt-tmp-*/
.adopt-bak-*/
