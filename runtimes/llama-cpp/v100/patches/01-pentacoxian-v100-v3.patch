+        ggml_tensor * mm = cgraph->nodes[j];
+        if (!ggml_cuda_is_small_gemv_f(mm) || !(mm->flags & GGML_TENSOR_FLAG_COMPUTE) || cuda_ctx->precomputed.count(mm) ||
