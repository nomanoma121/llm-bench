+                const int old = v.id_of_slot[selected];
+                if (old >= 0) { v.slot_for_id[old] = -1; }
+                const int e = missing[i];
+                v.id_of_slot[selected] = base + e;
+                v.slot_for_id[base + e] = selected;
+                v.usage[selected] = tick;
+                v.fetch_experts[i] = e;
+                v.fetch_slots[i] = selected;
+            }
