+    if (src == nullptr || !ggml_cuda_ranges_overlap(dst, src)) {
+        return src ? src->data : nullptr;
+    }
+    const size_t n = ggml_nbytes(src);
+    tmp.alloc(n);
+    CUDA_CHECK(cudaMemcpyAsync(tmp.get(), src->data, n, cudaMemcpyDeviceToDevice, ctx.stream()));
+    return tmp.get();
