+        a.cdst[c] = (char *) copies[c]->src[1]->data;
+        a.cofs[c] = copies[c]->src[0]->view_offs / concat->nb[0];
+        a.cne0[c] = copies[c]->src[0]->ne[0];
+    }
+    const int64_t ne = a.ne0*a.ne1*a.ne2;
+    concat_copies_f32<<<(ne + 255) / 256, 256, 0, ctx.stream()>>>(a);
