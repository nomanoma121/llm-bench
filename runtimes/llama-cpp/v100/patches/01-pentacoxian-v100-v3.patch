+    inp_mem->uses_recr = false; // the MTP block is an attention layer
+    const auto * mctx_hyb = static_cast<const llama_memory_hybrid_idx_context *>(inp_mem->mctx);
+    auto * inp_attn = inp_mem->get_attn();
