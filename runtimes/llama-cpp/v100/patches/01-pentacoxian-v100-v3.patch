+    const size_t row_offset = (size_t) row * blocks_per_row * NBINS;
+    block_histograms[row_offset + (size_t) row_block * NBINS + tid] = histogram[tid];
+    __threadfence();
+    __syncthreads();
+    if (tid == 0) {
+        is_last = atomicAdd(&counters[row], 1u) == (unsigned int) blocks_per_row - 1;
+    }
+    __syncthreads();
+    if (!is_last) {
