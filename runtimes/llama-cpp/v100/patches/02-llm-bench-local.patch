+// Runs one CPU split at a time on a dedicated thread, so ggml_backend_sched can keep submitting
+// GPU splits instead of blocking on the CPU for the whole split. The thread is persistent: ggml's
+// threadpool expects to be driven by one and the same caller.
+//
+// Enabled with GGML_CPU_ASYNC=1. With an offloaded MoE the CPU half of each layer's experts is
+// independent of the GPU half, so hiding it behind GPU work turns a step from
+// cpu + gpu into max(cpu, gpu).
+struct ggml_backend_cpu_async {
+    std::thread             thr;
+    std::mutex              mtx;
+    std::condition_variable cv;
+
+    bool has_work = false;
+    bool idle     = true;
+    bool quit     = false;
+
+    struct ggml_cgraph graph = {};
+    struct ggml_cplan  cplan = {};
+    enum ggml_status   status = GGML_STATUS_SUCCESS;
+
+    void start() {
+        thr = std::thread([this]() {
+            std::unique_lock<std::mutex> lk(mtx);
+            while (true) {
+                cv.wait(lk, [this]() { return has_work || quit; });
+                if (quit) {
+                    return;
+                }
+                has_work = false;
+                idle     = false;
+                lk.unlock();
+                const enum ggml_status st = ggml_graph_compute(&graph, &cplan);
+                lk.lock();
+                if (st != GGML_STATUS_SUCCESS) {
+                    status = st;
+                }
+                idle = true;
+                cv.notify_all();
+            }
+        });
+    }
+
+    // Block until the worker has nothing outstanding.
+    void join() {
+        std::unique_lock<std::mutex> lk(mtx);
+        cv.wait(lk, [this]() { return idle && !has_work; });
+    }
+
+    void submit(const struct ggml_cgraph * g, const struct ggml_cplan * c) {
+        std::unique_lock<std::mutex> lk(mtx);
+        cv.wait(lk, [this]() { return idle && !has_work; });
+        graph    = *g;   // shallow: the node array belongs to the scheduler and outlives the split
+        cplan    = *c;
+        has_work = true;
+        idle     = false;
+        cv.notify_all();
+    }
+
+    enum ggml_status take_status() {
+        std::unique_lock<std::mutex> lk(mtx);
+        const enum ggml_status st = status;
+        status = GGML_STATUS_SUCCESS;
+        return st;
+    }
+
+    ~ggml_backend_cpu_async() {
+        if (thr.joinable()) {
+            {
+                std::unique_lock<std::mutex> lk(mtx);
+                cv.wait(lk, [this]() { return idle && !has_work; });
+                quit = true;
+                cv.notify_all();
+            }
+            thr.join();
+        }
+    }
+};
