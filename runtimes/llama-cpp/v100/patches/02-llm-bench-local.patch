+    if (!ggml_backend_sched_alloc_graph(sched_use, gf)) {
+        LLAMA_LOG_ERROR("%s: failed to allocate pipeline half graph (il = [%d, %d))\n", __func__, il_begin, il_end);
+        return nullptr;
+    }
