+    gparams.il_end   = il_end;
+    gparams.res_in   = res_in;
+    gparams.res_out  = res_out;
+
+    if (!graph_reuse_disable && active && res->can_reuse(gparams)) {
+        res->set_inputs(&ubatch);
+        return res;
+    }
