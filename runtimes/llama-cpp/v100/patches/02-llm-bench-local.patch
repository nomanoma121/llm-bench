+// mul_mat_id CPU kernel microbenchmark: Q4_K [2560,640,512] x f32 [2560,M] ids [10,M]
+// 実モデルの形状 (qwen4exp: n_embd=2560, n_ff_exp=640, 512 experts, 10 used)
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include "ggml.h"
+#include "ggml-cpu.h"
+#include "ggml-alloc.h"
+
+static double now_s(void){ struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts); return ts.tv_sec+1e-9*ts.tv_nsec; }
+
+int main(int argc, char ** argv) {
+    const int64_t n_embd = argc>1 ? atoll(argv[1]) : 2560;
+    const int64_t n_ff   = argc>2 ? atoll(argv[2]) : 640;
+    const int64_t n_exp  = argc>3 ? atoll(argv[3]) : 512;
+    const int64_t n_used = argc>4 ? atoll(argv[4]) : 10;
+    const int nth        = argc>5 ? atoi(argv[5])  : 12;
+    const int M_list[] = {1, 3, 8, 16, 32, 64, 128, 256, 512};
+    const int nM = 9;
+
+    struct ggml_init_params ip = { .mem_size = 560ULL*1024*1024, .mem_buffer = NULL, .no_alloc = 0 };
+    struct ggml_context * ctx = ggml_init(ip);
+
+    struct ggml_tensor * w   = ggml_new_tensor_3d(ctx, GGML_TYPE_Q4_K, n_embd, n_ff, n_exp);
+    struct ggml_tensor * x   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32,  n_embd, n_used, 512);
+    struct ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32,  n_used, 512);
+
+    srand(1234);
+    unsigned char * wbuf = (unsigned char *) w->data;
+    unsigned int st = 0x12345678u;
+    for (size_t i = 0; i < ggml_nbytes(w); i++) { st ^= st<<13; st ^= st>>17; st ^= st<<5; wbuf[i] = (unsigned char)st; }
+    float * xb = (float *) x->data;
+    for (int64_t i = 0; i < ggml_nelements(x); i++) xb[i] = (float)((rand()%2000)-1000)/512.f;
+    int32_t * ib = (int32_t *) ids->data;
+    for (int64_t i = 0; i < ggml_nelements(ids); i++) ib[i] = rand() % n_exp;
+
+    ggml_backend_t backend = ggml_backend_cpu_init();
+    ggml_backend_cpu_set_n_threads(backend, nth);
+
+    printf("n_embd=%lld n_ff=%lld n_exp=%lld n_used=%lld nth=%d  (Q4_K bank = %.1f MiB)\n",
+           (long long)n_embd,(long long)n_ff,(long long)n_exp,(long long)n_used,nth,
+           ggml_nbytes(w)/1048576.0);
+    printf("%8s %10s %12s %12s %12s\n", "M", "ms/iter", "tok/s", "GiB/s(組)", "GiB/s(実)");
+
+    for (int mi = 0; mi < nM; mi++) {
+        const int64_t M = M_list[mi];
+        struct ggml_cgraph * gf;
+        struct ggml_tensor * xM  = ggml_view_3d(ctx, x, n_embd, n_used, M, ggml_row_size(GGML_TYPE_F32,n_embd), ggml_row_size(GGML_TYPE_F32,n_embd)*n_used, 0);
+        struct ggml_tensor * idsM= ggml_view_2d(ctx, ids, n_used, M, ggml_row_size(GGML_TYPE_I32,n_used), 0);
+        struct ggml_tensor * out = ggml_mul_mat_id(ctx, w, xM, idsM);
+
+        gf = ggml_new_graph(ctx);
+        ggml_build_forward_expand(gf, out);
+
+        ggml_gallocr_t alloc = ggml_gallocr_new(ggml_backend_get_default_buffer_type(backend));
+        if (!ggml_gallocr_reserve(alloc, gf)) { printf("alloc fail\n"); return 1; }
+        ggml_gallocr_alloc_graph(alloc, gf);
+
+        // warmup
+        for (int i = 0; i < 3; i++) ggml_backend_graph_compute(backend, gf);
+        const int iters = M >= 256 ? 5 : 10;
+        double t0 = now_s();
+        for (int i = 0; i < iters; i++) ggml_backend_graph_compute(backend, gf);
+        double dt = (now_s()-t0)/iters;
+
+        const double bytes_union = (double)M; // expected distinct experts hit
+        // 実読み込み量: ユニークなエキスパート数 × 1エキスパートのバンク
+        int seen[512]; memset(seen,0,sizeof(seen)); int uniq=0;
+        for (int64_t i = 0; i < n_used*M; i++) { int v=ib[i%(n_used*512)]; if(!seen[v]){seen[v]=1;uniq++;} }
+        const double exp_bytes = (double)uniq * ggml_nbytes(w)/n_exp;
+        printf("%8lld %10.2f %12.1f %12.1f %12.1f\n", (long long)M, dt*1e3,
+               M/dt, ggml_nbytes(w)/(dt*1073741824.0),
+               exp_bytes/(dt*1073741824.0));
+        ggml_gallocr_free(alloc);
+        (void)bytes_union;
+    }
+    ggml_backend_free(backend);
+    ggml_free(ctx);
+    return 0;
+}
