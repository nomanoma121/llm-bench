+// pipeline split (GGML_Q4_PIPE): overlap the CPU tail of ubatch n-1 with the GPU head
+// of ubatch n. the model layers are split at `pipe_split` - the first layer whose routed
+// experts live in host memory:
+//   A: layers [0, pipe_split)       -> runs on the GPU
+//   B: layers [pipe_split, n_layer) -> runs on the CPU (+ GPU attention)
+// the wide residual at the boundary is staged through a host buffer. B(n-1) is computed
+// while A(n) is in flight on the GPU, so the serial "GPU head -> CPU tail" chain of
+// consecutive ubatches overlaps.
+//
+// only used for pure prompt batches: a single output on the very last token, no backend
+// samplers, no pooled embeddings, no EAGLE3-style layer extraction.
+// returns 1 if handled, 0 if not applicable (caller falls back to the normal path), <0 on error
+int llama_context::decode_pipeline(llama_memory_context_i * mctx) {
+    const int il_split = pipe_split;
+    const int il_end   = (int) model.hparams.n_layer();
+
+    if (!pipe_res_a) {
+        pipe_res_a.reset(new llm_graph_result(graph_max_nodes(std::min(cparams.n_ctx, cparams.n_ubatch))));
+    }
+
+    // host staging for the wide residual [n_embd, hc, n_ubatch]
+    {
+        const int64_t hc = model.hparams.dsv4_hc_mult;
+        const size_t nbytes = (size_t) model.hparams.n_embd * hc * cparams.n_ubatch * sizeof(float);
+        if (pipe_buf.size() < nbytes) {
+            pipe_buf.resize(nbytes);
+        }
+    }
+
+    // producer/consumer: a dedicated thread submits the head graphs on its own CUDA
+    // streams, so the head kernels run next to the tail's kernels instead of queueing
+    // ahead of them, and the (blocking) head submission overlaps the tail compute
+    std::mutex              pipe_mtx;
+    std::condition_variable pipe_cv;
+
+    int  a_built    = -1; // highest ubatch whose head graph is built
+    int  copied     = -1; // highest boundary staged into pipe_buf
+    int  consumed   = -1; // highest boundary taken by the tail thread
+    bool prod_error = false;
+    bool pipe_stop  = false;
+
+    std::thread producer([&]() {
+        for (uint32_t n = 0; ; ++n) {
+            {
+                std::unique_lock<std::mutex> lk(pipe_mtx);
+                pipe_cv.wait(lk, [&] { return prod_error || pipe_stop || a_built >= (int) n; });
+                if (prod_error || pipe_stop) {
+                    return;
+                }
+            }
+
+            const int64_t pa0 = ggml_time_us();
+            if (ggml_backend_sched_graph_compute_async(sched_pipe_a.get(), pipe_res_a->get_gf()) != GGML_STATUS_SUCCESS) {
+                std::lock_guard<std::mutex> lk(pipe_mtx);
+                prod_error = true;
+                pipe_cv.notify_all();
+                return;
+            }
+            const int64_t pa1 = ggml_time_us();
+
+            // wait for the head to finish: frees sched_pipe_a for the next build
+            ggml_backend_sched_synchronize(sched_pipe_a.get());
+            const int64_t pa2 = ggml_time_us();
+            (void) pa0; (void) pa1; (void) pa2;
+
+            // stage the boundary residual for the tail
+            {
+                std::unique_lock<std::mutex> lk(pipe_mtx);
+                pipe_cv.wait(lk, [&] { return prod_error || pipe_stop || consumed >= (int) n - 1; });
+                if (prod_error || pipe_stop) {
+                    return;
+                }
+            }
+
+            {
+                ggml_tensor * t_out = pipe_res_a->get_res_out();
+                if (t_out == nullptr || ggml_nbytes(t_out) > pipe_buf.size()) {
+                    std::lock_guard<std::mutex> lk(pipe_mtx);
+                    prod_error = true;
+                    pipe_cv.notify_all();
+                    return;
+                }
+                ggml_backend_tensor_get(t_out, pipe_buf.data(), 0, ggml_nbytes(t_out));
+            }
+
+            {
+                std::lock_guard<std::mutex> lk(pipe_mtx);
+                copied = n;
+                pipe_cv.notify_all();
+            }
+        }
+    });
+
+    auto pipe_fail = [&](const char * what) {
+        {
+            std::lock_guard<std::mutex> lk(pipe_mtx);
+            prod_error = true;
+            pipe_cv.notify_all();
+        }
+        producer.join();
+        LLAMA_LOG_ERROR("%s: pipeline %s failed\n", __func__, what);
+        return -1;
+    };
+
+    auto wait_for = [&](const std::function<bool()> & pred) {
+        std::unique_lock<std::mutex> lk(pipe_mtx);
+        pipe_cv.wait(lk, [&] { return prod_error || pred(); });
+        return !prod_error;
+    };
+
+    bool act_a = false;
+    bool act_b = false;
+
+    int64_t n_tokens_prev = 0; // tokens finalized before the ubatch being finalized now
+    int64_t n_fin_tokens  = 0; // n_tokens of the last finalized ubatch
+    llm_graph_result * res_b_prev = nullptr;
+
+    uint32_t n_ub = 0;
+    for (;;) {
+        const llama_ubatch & ubatch = mctx->get_ubatch();
+
+        if (!mctx->apply()) {
+            return pipe_fail("memory context apply");
+        }
+
+        // wait until the producer staged boundary(n-1) (and the head graph n-1 completed)
+        if (n_ub > 0 && !wait_for([&] { return copied >= (int) n_ub - 1; })) {
+            return pipe_fail("head sync");
+        }
+
+        // build the head graph (mctx state for this ubatch) and let the producer submit it;
+        // the submission overlaps the tail compute below
+        if (!pipe_build_half(pipe_res_a.get(), act_a, ubatch, mctx, 0, il_split, false, true, sched_pipe_a.get())) {
+            if (n_ub == 0) {
+                // nothing submitted yet: fall back to the normal path
+                {
+                    std::lock_guard<std::mutex> lk(pipe_mtx);
+                    pipe_stop = true;
+                    pipe_cv.notify_all();
+                }
+                producer.join();
+                return 0;
+            }
+            return pipe_fail("head build");
+        }
+        {
+            std::lock_guard<std::mutex> lk(pipe_mtx);
+            a_built = (int) n_ub;
+            pipe_cv.notify_all();
+        }
+
+        // consume boundary(n-1) and compute the tail while the producer submits the head
+        if (n_ub > 0) {
+            ggml_tensor * t_in = ggml_graph_get_tensor(res_b_prev->get_gf(), "hc_pipe_in");
+            if (t_in == nullptr || ggml_nbytes(t_in) > pipe_buf.size()) {
+                return pipe_fail("tail boundary input");
+            }
+            ggml_backend_tensor_set(t_in, pipe_buf.data(), 0, ggml_nbytes(t_in));
+
+            {
+                std::lock_guard<std::mutex> lk(pipe_mtx);
+                consumed = (int) n_ub - 1;
+                pipe_cv.notify_all();
+            }
+
+            const int64_t tb0 = ggml_time_us();
+            if (graph_compute(res_b_prev->get_gf(), true, sched_pipe_b.get()) != GGML_STATUS_SUCCESS) {
+                return pipe_fail("tail compute");
+            }
+            ggml_backend_sched_synchronize(sched_pipe_b.get());
+            const int64_t tb1 = ggml_time_us();
+            (void) tb0; (void) tb1;
+
+            // the MTP target context wants the hidden state of every prompt token
+            if (embd_nextn.data && !cparams.embeddings_nextn_masked) {
+                ggml_tensor * t_h = res_b_prev->get_h_nextn();
+                if (t_h != nullptr) {
+                    const uint32_t n_embd = model.hparams.n_embd_out();
+                    if ((n_tokens_prev + n_fin_tokens)*n_embd > (int64_t) embd_nextn.size) {
+                        return pipe_fail("nextn size");
+                    }
+                    ggml_backend_tensor_get(t_h, embd_nextn.data + n_tokens_prev*n_embd, 0, n_fin_tokens*n_embd*sizeof(float));
+                }
+            }
+            n_tokens_prev += n_fin_tokens;
+        }
+
+        // count the outputs of this ubatch and build the tail graph (B(n-1) is done, so
+        // rebuilding on the same scheduler cannot clobber it)
+        {
+            int32_t n_outputs_new = 0;
+            for (uint32_t i = 0; i < ubatch.n_tokens; i++) {
+                n_outputs_new += (int32_t) (ubatch.output[i] != 0);
+            }
+            // needs to happen before the graph is built
+            n_outputs = n_outputs_new;
+        }
+        if (!pipe_build_half(pipe_res_b.get(), act_b, ubatch, mctx, il_split, il_end, true, false, sched_pipe_b.get())) {
+            if (n_ub == 0) {
+                {
+                    std::lock_guard<std::mutex> lk(pipe_mtx);
+                    pipe_stop = true;
+                    pipe_cv.notify_all();
+                }
+                producer.join();
+                return 0;
+            }
+            return pipe_fail("tail build");
+        }
+
+        const bool more = mctx->next();
+
+        res_b_prev    = pipe_res_b.get();
+        n_fin_tokens  = ubatch.n_tokens;
+
+        n_ub++;
+        if (!more) {
+            break;
+        }
+    }
+
+    // drain: compute the last tail
+    GGML_ASSERT(res_b_prev != nullptr);
+
+    if (!wait_for([&] { return copied >= (int) n_ub - 1; })) {
+        return pipe_fail("head sync (drain)");
+    }
+    {
+        ggml_tensor * t_in = ggml_graph_get_tensor(res_b_prev->get_gf(), "hc_pipe_in");
+        if (t_in == nullptr || ggml_nbytes(t_in) > pipe_buf.size()) {
+            return pipe_fail("tail boundary input (drain)");
+        }
+        ggml_backend_tensor_set(t_in, pipe_buf.data(), 0, ggml_nbytes(t_in));
+    }
+    {
+        std::lock_guard<std::mutex> lk(pipe_mtx);
+        consumed = (int) n_ub - 1;
+        pipe_cv.notify_all();
+    }
+
+    if (graph_compute(res_b_prev->get_gf(), true, sched_pipe_b.get()) != GGML_STATUS_SUCCESS) {
+        return pipe_fail("tail compute (drain)");
+    }
+    ggml_backend_sched_synchronize(sched_pipe_b.get());
+
+    // stop the producer
+    {
+        std::lock_guard<std::mutex> lk(pipe_mtx);
+        pipe_stop = true;
+        pipe_cv.notify_all();
+    }
+    producer.join();
+
+    // extract the outputs of the final ubatch (the only one with outputs)
+    {
+        auto * res = res_b_prev;
+        auto * t_logits = res->get_logits();
+
+        const int64_t n_vocab = model.vocab.n_tokens();
+
+        if (logits.data && t_logits && n_outputs > 0) {
+            GGML_ASSERT((size_t) n_outputs*n_vocab <= logits.size);
+            ggml_backend_tensor_get(t_logits, logits.data, 0, (size_t) n_outputs*n_vocab*sizeof(float));
+        }
+
+        if (res->get_argmax() && n_outputs > 0) {
+            ggml_tensor * t_am = res->get_argmax();
+            if ((int64_t) argmax_ids.size() < n_outputs) {
+                argmax_ids.resize(n_outputs, -1);
+            }
+            ggml_backend_tensor_get(t_am, argmax_ids.data(), 0, (size_t) n_outputs*sizeof(int32_t));
+        }
+
+        if (embd_nextn.data && !cparams.embeddings_nextn_masked) {
+            ggml_tensor * t_h = res->get_h_nextn();
+            if (t_h != nullptr) {
+                const uint32_t n_embd = model.hparams.n_embd_out();
+                GGML_ASSERT((n_tokens_prev + n_fin_tokens)*n_embd <= (int64_t) embd_nextn.size);
+                ggml_backend_tensor_get(t_h, embd_nextn.data + n_tokens_prev*n_embd, 0, n_fin_tokens*n_embd*sizeof(float));
+            }
+        }
+    }
